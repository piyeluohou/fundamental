{
  "name": "fundamental",
  "version": "1.0.0",
  "description": "大基本功",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "test": "pnpm run check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src/ coding/ config/ vite.config.ts",
    "lint:fix": "eslint src/ coding/ config/ vite.config.ts --fix",
    "preinstall": "node scripts/check-package-manager.mjs",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.22.1",
    "pnpm": "12.18.0"
  },
  "packageManager": "pnpm@12.18.0",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
